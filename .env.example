# Copy to .env for local dev, or set these as Railway service variables.

# Postgres connection string. Railway's Postgres addon injects DATABASE_URL automatically
# once attached to this service — you don't need to set it by hand there.
DATABASE_URL=postgresql://user:pass@localhost:5432/moviemaker

# Server-side only. Never sent to the browser. Set this in Railway's dashboard
# (Variables tab), not in this file if you commit it.
OPENROUTER_API_KEY=

# Local disk path for generated media. On Railway this should be the mount path
# of an attached Volume (Settings -> Volumes), e.g. /data.
MEDIA_ROOT=./data

# Optional public origin for absolute media URLs (e.g. https://your-app.up.railway.app).
# Needed for chain-frame image URLs that OpenRouter must fetch.
# PUBLIC_BASE_URL=

# Video generation default: MiniMax H3 on OpenRouter.
# https://openrouter.ai/minimax/hailuo-3 — resolution must be 2K; duration 5–15s.
DEFAULT_VIDEO_MODEL=minimax/hailuo-3
DEFAULT_SCENE_RESOLUTION=2K
DEFAULT_SCENE_ASPECT_RATIO=16:9
DEFAULT_SCENE_DURATION=5

# Still used only for reference portraits/stills (not chat/planning).
DEFAULT_IMAGE_MODEL=google/gemini-2.5-flash-image

# Legacy in-app OpenRouter chat agent (unused when planning in Cursor).
# DEFAULT_AGENT_MODEL=anthropic/claude-sonnet-4.5
